# Copie para .env. Sem as duas primeiras linhas o app abre em modo demonstração.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive (Google Cloud Console > Credenciais > IDs do cliente OAuth)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# OneDrive (Microsoft Entra > Registros de aplicativo, cliente público)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# iCloud (CloudKit Console > container iCloud.br.com.nuvigia > API Access > token)
EXPO_PUBLIC_CLOUDKIT_CONTAINER=iCloud.br.com.nuvigia
EXPO_PUBLIC_CLOUDKIT_API_TOKEN=
EXPO_PUBLIC_CLOUDKIT_ENV=development

# Notificações (ID do projeto no EAS: `eas init` mostra). Sem ele o app não pede token de push.
EAS_PROJECT_ID=
