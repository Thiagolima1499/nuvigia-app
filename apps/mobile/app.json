{
  "expo": {
    "name": "Nuvigia",
    "slug": "nuvigia",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.nuvigia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c67139",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.nuvigia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "O Nuvigia usa a câmera para ler o QR code do hub.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "O Nuvigia usa a câmera para ler o QR do hub.",
          "microphonePermission": "O Nuvigia usa o microfone quando você toca em Falar para conversar pela câmera."
        }
      ],
      "expo-video"
    ],
    "scheme": "nuvigia",
    "backgroundColor": "#f5ead8",
    "experiments": {
      "typedRoutes": true
    }
  }
}
