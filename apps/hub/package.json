{
  "name": "@nuvigia/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Hub Nuvigia: roda na rede de casa, lê as câmeras (RTSP/ONVIF), grava e envia para a nuvem.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@nuvigia/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "bonjour-service": "^1.4.4",
    "onvif": "^0.8.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  }
}
