# Copie para .env e preencha. Nunca coloque este arquivo no Git.

# Projeto Supabase (Configurações > API). A chave anon é pública; a service role NÃO vai aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Mesmo valor de `supabase secrets set HUB_REGISTRATION_SECRET=...` (opcional, recomendado).
HUB_REGISTRATION_SECRET=

# Chave que cifra no disco as senhas das câmeras, a identidade do hub e os tokens da nuvem.
# Gere uma vez com:  openssl rand -base64 32   e guarde em lugar seguro (sem ela, é preciso parear de novo).
HUB_SECRET_KEY=

HUB_NAME=Casa
# Página local de pareamento: http://<ip-do-hub>:8787
HTTP_PORT=8787

# Gravação
SEGMENT_SECONDS=300
MOTION_CLIP_SECONDS=30
MOTION_SENSITIVITY=0.02
LOCAL_KEEP_DAYS=3

LOG_LEVEL=info
